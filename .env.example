# ─── Login Dashboard Admin ───────────────────────────────────────────────
ADMIN_EMAIL=admin@astayodha.id
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Kunci rahasia untuk menandatangani sesi login (isi string acak panjang)
# Contoh membuat nilai acak: openssl rand -hex 32
ADMIN_SECRET=ganti-dengan-string-acak-panjang

# ─── Database (Arsip Surat & Keanggotaan) ────────────────────────────────
# Otomatis terisi jika Anda menghubungkan Postgres (Neon) lewat tab
# "Storage" di dashboard Vercel. Untuk pengembangan lokal, isi manual
# dengan connection string dari Neon/Supabase/Postgres lokal Anda.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ─── Penyimpanan File (unggahan surat & foto anggota) ────────────────────
# Otomatis terisi jika Anda menghubungkan Blob store lewat tab "Storage"
# di dashboard Vercel.
BLOB_READ_WRITE_TOKEN=
